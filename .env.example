# Application
APP_NAME=Self-Improving Multimodal Code Review
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Security
SECRET_KEY=replace-with-a-long-random-local-development-secret

# OpenRouter.env.example
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=self-improving-multimodal-code-review

# Model aliases; configure actual model IDs later in Phase 1
OPENROUTER_REVIEW_MODEL=
OPENROUTER_CRITIC_MODEL=
OPENROUTER_ROUTER_MODEL=
OPENROUTER_VISION_MODEL=
OPENROUTER_JUDGE_MODEL=
OPENROUTER_EMBEDDING_MODEL=

# Database; Postgres is introduced in Phase 2/3
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_review

# Redis and background jobs; introduced in Phase 2
REDIS_URL=redis://localhost:6379/0

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_DATASET_TOKEN=

# Langfuse; introduced fully in Phase 9, safe to configure now
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PROJECT_ID=

VISION_ENABLED=false
FEEDBACK_HASH_SECRET=
