+def get_ca_bundle_from_env() -> typing.Optional[str]:
+    ssl_path = Path(os.getenv("SSL_CERT_FILE", ""))
+    if ssl_path and ssl_path.is_file():
+        return str(ssl_path)
+    ssl_path = Path(os.getenv("SSL_CERT_DIR", ""))
+    if ssl_path and ssl_path.is_dir():
+        return str(ssl_path)
+    return None
