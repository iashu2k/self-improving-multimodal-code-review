diff --git a/tools/packaging/osrepos/scripts/sign-rpms.sh b/tools/packaging/osrepos/scripts/sign-rpms.sh
index 807397991ac3..67394e635169 100644
--- a/tools/packaging/osrepos/scripts/sign-rpms.sh
+++ b/tools/packaging/osrepos/scripts/sign-rpms.sh
@@ -9,6 +9,18 @@ GPG_TTY=""
